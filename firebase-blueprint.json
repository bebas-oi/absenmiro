{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/blueprint.schema.json",
  "entities": {
    "settings": {
      "title": "Settings",
      "description": "School operational schedule and kiosk settings",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "subTitle": { "type": "string" },
        "address": { "type": "string" },
        "logoUrl": { "type": "string" },
        "headmasterName": { "type": "string" },
        "headmasterNip": { "type": "string" },
        "timeInStart": { "type": "string" },
        "timeInLate": { "type": "string" },
        "timeInEnd": { "type": "string" },
        "timeOutStandard": { "type": "string" },
        "timeOutFriday": { "type": "string" },
        "autoMode": { "type": "boolean" },
        "soundEnabled": { "type": "boolean" },
        "kioskCooldownSeconds": { "type": "number" },
        "kioskManualPin": { "type": "string" }
      }
    },
    "classes": {
      "title": "ClassRoom",
      "description": "School classroom definitions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "number" },
        "room": { "type": "string" },
        "academicYear": { "type": "string" },
        "homeroomTeacher": { "type": "string" },
        "totalStudents": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "teachers": {
      "title": "Teacher",
      "description": "Teachers and Homeroom teachers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nip": { "type": "string" },
        "name": { "type": "string" },
        "assignedClass": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "users": {
      "title": "UserAccount",
      "description": "User accounts with role-based access control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "assignedClass": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "password": { "type": "string" }
      },
      "required": ["id", "username", "role"]
    },
    "students": {
      "title": "Student",
      "description": "Student profiles and RFID cards",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nis": { "type": "string" },
        "nisn": { "type": "string" },
        "name": { "type": "string" },
        "className": { "type": "string" },
        "rfidUid": { "type": "string" },
        "gender": { "type": "string" },
        "parentPhone": { "type": "string" },
        "parentName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "nis", "name", "className", "rfidUid"]
    },
    "attendance": {
      "title": "AttendanceRecord",
      "description": "Student daily attendance log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "nis": { "type": "string" },
        "studentName": { "type": "string" },
        "className": { "type": "string" },
        "date": { "type": "string" },
        "timeIn": { "type": "string" },
        "timeOut": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "method": { "type": "string" },
        "notes": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "studentId", "date", "status"]
    },
    "exam_schedules": {
      "title": "ExamScheduleItem",
      "description": "ASAS and ASAT exam schedules per class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examType": { "type": "string", "enum": ["ASAS", "ASAT"] },
        "className": { "type": "string" },
        "date": { "type": "string" },
        "dayName": { "type": "string" },
        "timeStart": { "type": "string" },
        "timeEnd": { "type": "string" },
        "subject": { "type": "string" },
        "room": { "type": "string" },
        "supervisor": { "type": "string" }
      },
      "required": ["id", "examType", "className", "date", "subject"]
    },
    "exam_configs": {
      "title": "ExamMetaConfig",
      "description": "ASAS and ASAT exam metadata and card print configuration",
      "type": "object",
      "properties": {
        "examType": { "type": "string", "enum": ["ASAS", "ASAT"] },
        "academicYear": { "type": "string" },
        "semester": { "type": "string" },
        "periodLabel": { "type": "string" },
        "committeeChair": { "type": "string" },
        "committeeChairNip": { "type": "string" },
        "defaultRoom": { "type": "string" },
        "participantPrefix": { "type": "string" },
        "cardTheme": { "type": "string" },
        "backMode": { "type": "string" }
      },
      "required": ["examType", "academicYear"]
    },
    "exam_instruments": {
      "title": "ExamInstrumentConfig",
      "description": "ASAS and ASAT supervision instrument and administration sub-menu configuration",
      "type": "object",
      "properties": {
        "examType": { "type": "string", "enum": ["ASAS", "ASAT"] },
        "kopLine1": { "type": "string" },
        "kopLine2": { "type": "string" },
        "kopLine3": { "type": "string" },
        "kopAddress": { "type": "string" },
        "instrumentTitle": { "type": "string" },
        "academicYearLabel": { "type": "string" },
        "madrasahName": { "type": "string" },
        "supervisorName": { "type": "string" }
      },
      "required": ["examType", "instrumentTitle"]
    }
  },
  "firestore": {
    "collections": {
      "settings": {
        "entity": "settings",
        "description": "School operational settings"
      },
      "classes": {
        "entity": "classes",
        "description": "Classes in the school"
      },
      "teachers": {
        "entity": "teachers",
        "description": "Teacher profiles"
      },
      "users": {
        "entity": "users",
        "description": "Staff user accounts"
      },
      "students": {
        "entity": "students",
        "description": "Student master data"
      },
      "attendance": {
        "entity": "attendance",
        "description": "Attendance transaction logs"
      },
      "exam_schedules": {
        "entity": "exam_schedules",
        "description": "ASAS & ASAT exam schedules per class"
      },
      "exam_configs": {
        "entity": "exam_configs",
        "description": "ASAS & ASAT card and exam configurations"
      },
      "exam_instruments": {
        "entity": "exam_instruments",
        "description": "ASAS & ASAT supervision instrument and administration checklists"
      }
    }
  }
}
