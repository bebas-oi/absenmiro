rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // School Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Classes collection
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Teachers collection
    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    // Users (RBAC) collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Students collection
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Attendance logs collection
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // ASAS & ASAT exam schedules
    match /exam_schedules/{scheduleId} {
      allow read, write: if true;
    }

    // ASAS & ASAT exam configurations
    match /exam_configs/{examType} {
      allow read, write: if true;
    }

    // ASAS & ASAT supervision instruments
    match /exam_instruments/{examType} {
      allow read, write: if true;
    }

    // Katrol Nilai sheets
    match /grade_katrol/{katrolId} {
      allow read: if true;
      allow create, update: if katrolId is string
        && katrolId.size() <= 160
        && request.resource.data.id is string
        && request.resource.data.className is string
        && request.resource.data.subject is string
        && request.resource.data.kkm is number
        && request.resource.data.entries is list;
      allow delete: if true;
    }
  }
}
